# Copy this file to .env and fill in your Supabase project credentials to
# enable real cloud authentication and cross-device sync.
#
# LifeQuest runs perfectly well WITHOUT these set — it falls back to a local
# "Demo Mode" that stores your account and progress in this browser only.
#
# Get these values from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
